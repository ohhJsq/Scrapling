# ============================================
# Hermes Web UI & Agent - Docker 配置文件
# ============================================
# 复制此文件为 .env 并根据需要修改配置
# cp .env.example .env

# ============================================
# 镜像配置
# ============================================
# Hermes Agent 镜像
HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest

# Hermes Web UI 镜像 (使用预构建镜像，推荐)
WEBUI_IMAGE=ekkoye8888/hermes-web-ui:latest

# 容器名称
HERMES_AGENT_CONTAINER_NAME=hermes-agent
WEBUI_CONTAINER_NAME=hermes-webui

# ============================================
# 端口配置
# ============================================
# Web UI 访问端口
PORT=6060

# ============================================
# 数据持久化配置
# ============================================
# Hermes 数据存储目录
HERMES_DATA_DIR=./hermes_data

# ============================================
# 认证配置
# ============================================
# 是否禁用认证 (true/false)
# 警告：在公共网络上禁用认证有安全风险
AUTH_DISABLED=false

# 自定义认证令牌 (可选，留空则自动生成)
# AUTH_TOKEN=your_secure_token_here

# ============================================
# Hermes Agent 配置
# ============================================
# Hermes 二进制文件路径
HERMES_BIN=/opt/hermes/.venv/bin/hermes

# 允许 root 用户运行网关 (Docker 环境需要)
HERMES_ALLOW_ROOT_GATEWAY=1

# ============================================
# 网络配置
# ============================================
# CORS 允许的源 (默认为 *，生产环境建议限制)
CORS_ORIGINS=*

# ============================================
# 上传配置
# ============================================
# 上传文件临时目录
UPLOAD_DIR=/tmp/hermes-web-ui-uploads

# ============================================
# 时区配置
# ============================================
TZ=Asia/Shanghai
